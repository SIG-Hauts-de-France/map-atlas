{
  "name": "map-atlas",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/map-atlas/src",
  "prefix": "map-atlas",
  "tags": ["type:app", "published"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/map-atlas",
        "index": "apps/map-atlas/src/index.html",
        "main": "apps/map-atlas/src/main.ts",
        "polyfills": "apps/map-atlas/src/polyfills.ts",
        "tsConfig": "apps/map-atlas/tsconfig.app.json",
        "assets": [
          "apps/map-atlas/src/assets",
          {
            "glob": "*",
            "input": "translations",
            "output": "assets/i18n/"
          },
          {
            "glob": "*",
            "input": "conf",
            "output": "assets/configuration/"
          },
          {
            "glob": "**/*",
            "input": "assets-common",
            "output": "assets/"
          }
        ],
        "styles": [
          "tailwind.base.css",
          "apps/map-atlas/src/styles.css",
          "node_modules/tippy.js/dist/tippy.css",
          "node_modules/basiclightbox/dist/basicLightbox.min.css",
          "node_modules/ol/ol.css",
          "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "duration-relativetimeformat",
          "papaparse",
          "xlsx",
          "chroma-js",
          "@rgrove/parse-xml",
          "@messageformat/core",
          "rbush"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/map-atlas/src/environments/environment.ts",
              "with": "apps/map-atlas/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "map-atlas:build:production"
        },
        "development": {
          "proxyConfig": "proxy-config.js",
          "buildTarget": "map-atlas:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "map-atlas:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/map-atlas/src/**/*.ts",
          "apps/map-atlas/src/**/*.html"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/map-atlas"],
      "options": {
        "jestConfig": "apps/map-atlas/jest.config.ts"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx build map-atlas --base-href='/map-atlas/'",
          "docker build --build-arg APP_NAME=map-atlas -f ./tools/docker/Dockerfile.apps . -t $(tools/print-docker-tag.sh map-atlas)"
        ],
        "parallel": false
      }
    }
  }
}
